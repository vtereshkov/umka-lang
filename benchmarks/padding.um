import "std.um"

type T = struct {
    p: ^int
    pad: [999]int
}

var g: [100]T

fn test*(n: int) {
    x := 42
    var a: [100]T

    // Half of the pointers point to a local, half to the heap
    for i := 0; i < len(a); i++ {
        if i % 2 == 0 {
            a[i].p = &x
        } else {
            a[i].p = new(int)
            a[i].p^ = i
        }
        a[i].pad[len(a[i].pad) - 1] = i
    }

    for i := 0; i < n; i++ {
        g = a
        std::assert(g[len(g) - 1].pad[len(g[0].pad) - 1] == len(g) - 1)
    }

    std::assert(g[0].p^ == 42 && g[1].p^ == 1)

    // Must not hold pointers to locals when leaving the function
    var empty: [100]T
    g = empty

    printf("OK\n")
}

fn main() {
    test(50000)
}
