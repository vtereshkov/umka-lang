// Mandelbrot benchmark - Umka version
// Prints the hash of the output bitmap instead of the bitmap itself

import "std.um"

fn test*(n: int) {
    const (maxIter = 50; limit = 2.0)

    out := []char(sprintf("P4\n%v %v\n", n, n))

    for y := 0; y < n; y++ {
        ci := 2.0 * y / n - 1.0
        bits, numBits := 0, 0

        for x := 0; x < n; x++ {
            cr := 2.0 * x / n - 1.5
            zr, zi, tr, ti := 0.0, 0.0, 0.0, 0.0

            for i := 0; i < maxIter && tr + ti <= limit * limit; i++ {
                zi = 2.0 * zr * zi + ci
                zr = tr - ti + cr
                tr = zr * zr
                ti = zi * zi
            }

            bits <<= 1
            if tr + ti <= limit * limit {
                bits |= 1
            }
            numBits++

            if numBits == 8 || x == n - 1 {
                bits <<= 8 - numBits
                out = append(out, char(bits))
                bits, numBits = 0, 0
            }
        }
    }

    // FNV-1a
    hash := uint(14695981039346656037)
    for _, c in out {
        hash = (hash ~ uint(c)) * 1099511628211
    }

    printf("length %v, hash %v\n", len(out), hash)
}

fn main() {
    if std::argc() == 2 {
        test(std::atoi(std::argv(1)))
    }
}
