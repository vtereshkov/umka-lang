// Spectral norm benchmark - Umka version

import "std.um"

fn a(i, j: int): real {
    return 1.0 / ((i + j) * (i + j + 1) / 2 + i + 1)
}

fn multiplyAv(v, av: []real) {
    for i in av {
        sum := 0.0
        for j, x in v {
            sum += a(i, j) * x
        }
        av[i] = sum
    }
}

fn multiplyAtv(v, atv: []real) {
    for i in atv {
        sum := 0.0
        for j, x in v {
            sum += a(j, i) * x
        }
        atv[i] = sum
    }
}

fn multiplyAtAv(v, atav: []real) {
    u := make([]real, len(v))
    multiplyAv(v, u)
    multiplyAtv(u, atav)
}

fn test*(n: int) {
    u := make([]real, n)
    v := make([]real, n)

    for i in u {
        u[i] = 1.0
    }

    for i := 0; i < 10; i++ {
        multiplyAtAv(u, v)
        multiplyAtAv(v, u)
    }

    vBv, vv := 0.0, 0.0
    for i in v {
        vBv += u[i] * v[i]
        vv += v[i] * v[i]
    }

    printf("%.9f\n", sqrt(vBv / vv))
}

fn main() {
    if std::argc() == 2 {
        test(std::atoi(std::argv(1)))
    }
}
