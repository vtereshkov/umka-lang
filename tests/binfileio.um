import "std.um"

fn write(name, s: str) {
	f, err := std::fopen(name, "wb")
	std::exitif(err)
	std::fwrite(f, &[]char(s))
	std::fclose(f)
}

fn read(name: str): str {
	f, err := std::fopen(name, "rb")
	std::exitif(err)
	data, err := std::freadall(f)
	std::exitif(err)
	std::fclose(f)
	return str(data)
}

fn test1() {
	name := "fio.txt"
	write(name, "Hello World")
	printf(read(name) + '\n')
	std::remove(name)	
}

fn test2() {
	f, err := std::fopen("galjkgaklgjkajg", "jgksjgksjgksjg")
	std::assert(f == null)
}

fn test3() {
	// fwrite() accepts a variable or a pointer to it, but not data containing pointers
	name := "fio.bin"
	x := 12345
	p := &x
	f, err := std::fopen(name, "wb")
	std::exitif(err)
	n1, _ := std::fwrite(f, x)
	n2, _ := std::fwrite(f, p)
	n3, err3 := std::fwrite(f, "hello")
	std::fclose(f)

	y, z := 0, 0
	f, err = std::fopen(name, "rb")
	std::exitif(err)
	n4, err4 := std::fread(f, &y)
	n5, err5 := std::fread(f, &z)
	std::fclose(f)
	std::remove(name)

	printf("%v %v %v %v | %v %v %v %v | %v %v\n", n1, n2, n3, err3.msg, n4, n5, err4.code, err5.code, y, z)
}

fn test4() {
	// fwrite() and fread() accept dynamic arrays of items without pointers
	name := "fio.bin"
	f, err := std::fopen(name, "wb")
	std::exitif(err)
	n1, _ := std::fwrite(f, []int{2, 4, 6})
	n2, _ := std::fwrite(f, []uint16{7, 8})
	n3, err3 := std::fwrite(f, []str{"hello"})
	std::fclose(f)

	a := make([]int, 3)
	b := make([]uint16, 2)
	f, err = std::fopen(name, "rb")
	std::exitif(err)
	n4, _ := std::fread(f, &a)
	n5, _ := std::fread(f, &b)
	std::fclose(f)
	std::remove(name)

	printf("%v %v %v %v | %v %v | %v %v\n", n1, n2, n3, err3.msg, n4, n5, a, b)
}

fn test*() {
	test1()
	test2()
	test3()
	test4()
}

fn main() {
	test()
}