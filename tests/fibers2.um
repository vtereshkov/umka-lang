fn foo(cnt: ^int) {   
    f := make(fiber, |cnt| {
        for true {
            cnt^++
            resume()
        }
    })    
    for i := 0; i < 42; i++ {
        resume(f)    
    }
}

fn test*() {
    cnt := new(int)
    foo(cnt)
    gc()
    printf("%v\n", cnt^)
}

fn main() {
    test()
}