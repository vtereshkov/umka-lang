// Data reachable in various ways survives garbage collections

type Node = struct {
    value: int
    next: ^Node
}

var global: ^Node

// Allocates and drops enough data to trigger collections and reuse the freed memory
fn churn() {
    for i := 0; i < 1000; i++ {
        a := new([1000]int)
        a[i] = i
    }
    gc()
}

// A pointer to an array item keeps the whole array alive
fn itemPtr(): ^int {
    a := new([1000]int)
    a[999] = 7
    return &a[999]
}

fn test1() {
    p := itemPtr()
    churn()
    printf("Item pointer: %v\n", p^)
}

// Heap data reachable through a struct copy, a closure, a map, an interface and a global variable
fn test2() {
    s := Node{1, new(Node)}
    s.next.value = 2

    q := new(Node)
    q.value = 3
    f := fn (): int |q| {return q.value}

    m := map[str]^Node{"x": new(Node)}
    m["x"].value = 4

    var i: any = Node{5, null}

    global = new(Node)
    global.value = 6

    churn()
    printf("Struct copy: %v, closure: %v, map: %v, interface: %v, global: %v\n", s.next.value, f(), m["x"].value, Node(i).value, global.value)
}

// A long list reachable only from its head
fn test3() {
    var head: ^Node
    for i := 0; i < 100000; i++ {
        head = &Node{i, head}
    }

    churn()

    n, sum := 0, 0
    for p := head; p != null; p = p.next {
        n++
        sum += p.value
    }
    printf("List: %v nodes, sum %v\n", n, sum)
}

fn test*() {
    test1()
    test2()
    test3()
}

fn main() {
    test()
}
