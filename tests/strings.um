import "std.um"

fn test1() {
	printf("\nTest 1\n\n")

	printf("Left trimming\n")

	printf("%v\n", std::ltrim("Hello World"))
	printf("%v\n", std::ltrim("  Hello World"))
	printf("%v\n", std::ltrim("Hello World   "))
	printf("%v\n", std::ltrim(" \tHello World   "))
	printf("%v\n", std::ltrim("    "))
	printf("%v\n", std::ltrim(""))

	printf("Right trimming\n")

	printf("%v\n", std::rtrim("Hello World"))
	printf("%v\n", std::rtrim("  Hello World"))
	printf("%v\n", std::rtrim("Hello World   "))
	printf("%v\n", std::rtrim(" \tHello World   "))
	printf("%v\n", std::rtrim("    "))
	printf("%v\n", std::rtrim(""))

	printf("Left & right trimming\n")

	printf("%v\n", std::trim("Hello World"))
	printf("%v\n", std::trim("  Hello World"))
	printf("%v\n", std::trim("Hello World   "))
	printf("%v\n", std::trim(" \tHello World   "))
	printf("%v\n", std::trim("    "))
	printf("%v\n", std::trim(""))
}

fn test2() {
	printf("\nTest 2\n\n")

    s := `aaa
    bb
c

    //
    /*
    "\\\"
    `
    printf("%s\n", s)
    printf("%v\n", []uint8(s))

    printf(`
Hello
World\n
`)    
}

fn test3() {
	printf("\nTest 3\n\n")

	s := "<a><!-- b --></a>"
	printf("%v %v %v %v %v %v\n", std::find(s, "<"), std::find(s, "<", 1), std::find(s, "-->", 4), std::find(s, "x"), std::find(s, "", len(s)), std::find("", ""))
	printf("%v %v %v %v %v\n", std::startswith(s, "<a>"), std::startswith(s, "<!--", 3), std::startswith(s, "<!--", 4), std::startswith(s, "</a>!", 13), std::startswith(s, "", len(s)))
	printf("%v %v %v %v\n", std::find(s, "<", -1), std::find(s, "", len(s) + 1), std::startswith(s, "", -1), std::startswith(s, "", len(s) + 1))
}

fn test*() {
	test1()
	test2()
	test3()
}

fn main() {
	test()
}
