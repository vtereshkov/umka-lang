fn foo(as: ..any) {
    for _, a in as {
        switch v := type(a) {
            case int: printf("int: %d + 5 = %d\n", v, v + 5)
            case str: printf("str: %s + 5 = %s\n", v, v + "5")
            case []real: printf("[]real: %v + [5] = %v\n", v, append(copy(v), 5))
            default: printf("unknown: %v\n", a)
        }
    }
}

fn bar(as: ..any) {
    for _, a in as {
        switch v := type(a) {
            case ^int: v^ += 5
            case ^str: v^ += "5"
            case ^[]real: v^ = append(v^, 5.0)
            default: printf("unknown: %v\n", a)
        }
    }
}

fn baz(): int {
    return 1 + 2
}

fn sumInLoops(x: any, n: int): int {
    s := 0

    // "continue" from a type switch
    for i := 0; i < n; i++ {
        switch v := type(x) {
            case int:
                s += v
                continue
        }
    }

    // "break" from a type switch
    for i := 0; i < n; i++ {
        for true {
            switch v := type(x) {
                case int:
                    s += v
                    break
            }
        }
    }

    return s
}

fn test*() {
    a := 42
    b := "42"
    c := []real{42}
    d := 42.0

    foo(a, b, c, d)
    printf("\n")    

    bar(&a, &b, &c, &d)
    printf("\n")    

    foo(&a, &b, &c, &d)
    printf("\n") 

    x := any(baz)
    switch v := type(x) {
        case fn(): int:
            printf("hi\n")
        default:
            printf("bye\n")
    }    

    printf("%v\n", sumInLoops(1, 2000000))
}

fn main() {
    test()
}