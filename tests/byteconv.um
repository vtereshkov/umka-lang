import "std.um"

fn test*() {
	type Pt = struct {x, y: int16}
	p := Pt{23, -6}
	printf("%v\n", p)

	bytes := std::tobytes(&p)
	printf("%v\n", bytes)

	bytes[2]++
	printf("%v\n", bytes)
	
	std::frombytes(&p, bytes)
	printf("%v\n", p)

	// A variable is converted as is, a dynamic array as its items, a value containing pointers is not converted
	printf("%v %v %v\n", std::tobytes(p), std::tobytes([]char("hi")), len(std::tobytes("hi")))

	q := make([]int16, 2)
	std::frombytes(&q, std::tobytes([]int16{1, -2}))
	printf("%v %v %v\n", std::tobytes(q), q, len(std::tobytes([]str{"hi"})))
}

fn main() {
	test()
}