import "std.um"

fn test*() {
	type Pt = struct {x, y: int16}
	p := Pt{23, -6}
	printf("%v\n", p)

	bytes := std::tobytes(&p)
	printf("%v\n", bytes)

	bytes[2]++
	printf("%v\n", bytes)
	
	std::frombytes(&p, bytes)
	printf("%v\n", p)

	// A variable is converted as is, a byte dynamic array as its items, a value containing pointers is not converted
	printf("%v %v %v\n", std::tobytes(p), std::tobytes([]char("hi")), len(std::tobytes("hi")))
}

fn main() {
	test()
}