import "std.um"

fn test*() {
        t := std::time()
        printf("%v\n", std::mktime(std::localtime(t)) - t)

        d := std::DateTime{year: 2022, month: 10, day: 2, hour: 15, minute: 13, second: 32}
        printf(std::timestr(d) + '\n')

        c1 := std::clock()
        e := std::epochTime() - real(t)
        printf("%v\n", c1 >= 0.0 && c1 < 60.0)
        printf("%v\n", e >= 0.0 && e < 2.0)
        printf("%v\n", std::clock() >= c1)
}

fn main() {
        test()
}