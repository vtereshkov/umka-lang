import "std.um"

// Values pointed to by the items
fn values(a: [][2]^int): str {
    s := ""
    for _, x in a {
        s += sprintf(" %v/%v", x[0]^, x[1]^)
    }
    return s
}

fn f(b: [11][2]^int) {
    s := ""
    for _, x in b {
        s += sprintf(" %v/%v", x[0]^, x[1]^)
    }
    printf("b:%s\n", s)
}

fn slices() {
    a := []str{"Hello " + "World", "Hallo " + "Welt", "Salut " + "le Monde", "Privet " + "Mir"}

    // All ranges, with the end index counted from the start or, if negative, from the end
    for start := 0; start <= len(a); start++ {
        std::assert(slice(a, start) == slice(a, start, len(a)))

        for end := start; end <= len(a); end++ {
            s := slice(a, start, end)
            std::assert(len(s) == end - start)

            for i, x in s {
                std::assert(x == a[start + i])
            }

            if end < len(a) {
                std::assert(slice(a, start, end - len(a)) == s)
            }
        }
    }

    printf("%v %v %v %v\n", slice(a, 1, 3), slice(a, 2), slice(a, 1, -1), slice(a, 4, 4))
}

fn insertions() {
    a := []str{"Hello" + ' ', "World"}
    b := insert(copy(a), 1, "My " + "Wonderful")
    c := insert(copy(b), 1, ", ")
    d := insert(copy(c), 0, "Oh" + ',' + " ")
    e := insert(copy(d), len(d), "!")

    printf("%v\n", a)
    printf("%v\n", b)
    printf("%v\n", c)
    printf("%v\n", d)
    printf("%v\n", e)

    printf("%v\n", insert(insert([]int{}, 0, 42), 1, 43))
}

fn copies() {
    a := [][]int{[]int{5, 7}, []int{9, 11}}
    b := copy(a)
    a[1] = []int{10, 12}
    printf("%v %v\n", a, b)
}

fn conv1() {
    x := real32(1.0)
    a := []real{}
    a = append(a, x)
    a = insert(a, 1, 2 * x)
    printf("%v\n", a)
}

fn conv2() {
    x := 1.0
    a := []real32{}
    a = append(a, x)
    a = insert(a, 1, 2 * x)
    printf("%v\n", a)
}

fn conv() {
    conv1()
    conv2()
}

fn test*() {
    a := make([][2]^int, 10)

    for i in a {
        a[i] = [2]^int {new(int), new(int)}
        a[i][0]^ = 5 * i
        a[i][1]^ = 7 * i
    }
    printf("a:%s\n", values(a))

    a = append(a, [2]^int {new(int), new(int)})
    a[len(a) - 1][0]^ = 666
    a[len(a) - 1][1]^ = 777
    printf("a:%s\n", values(a))

    f(a)

    e := append(copy(a), [2]^int {new(int), new(int)})
    e[len(e) - 1][0]^ = 876
    e[len(e) - 1][1]^ = 765
    printf("e:%s\n", values(e))

    saved := copy(e)
    e = delete(e, 4)
    printf("e:%s\n", values(e))
    printf("saved:%s\n", values(saved))

    c := []int{3, 4, 5}
    c = append(c, []int{6, 7})
    printf("c: %v\n", c)

    d := [][]int{[]int{666, 777}, [2]int{888, 999}}
    d = append(d, [2]int {444, 555})
    printf("d: %v\n", d)

    insertions()
    slices()
    copies()
    conv()
}

fn main() {
	test()
}
