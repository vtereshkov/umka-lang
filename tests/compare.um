// Compares two text files line by line and reports the first difference
// Usage: umka compare.um <actual file> <expected file>

import "std.um"

fn readLines(name: str): []str {
    f, err := std::fopen(name, "rb")
    std::exitif(err)
    data, err := std::freadall(f)
    std::exitif(err)
    std::fclose(f)

    lines := []str{}
    start := 0
    for i := 0; i <= len(data); i++ {
        if i == len(data) || data[i] == '\n' {
            // Carriage returns at the end of a line are ignored, since line endings differ between Windows and Linux,
            // and a text file written and read back on Windows gets an extra one
            end := i
            for end > start && data[end - 1] == '\r' {
                end--
            }

            // No empty line after the final line break
            if i < len(data) || end > start {
                lines = append(lines, str(slice(data, start, end)))
            }
            start = i + 1
        }
    }
    return lines
}

fn main() {
    std::assert(std::argc() == 3, "Need two files to compare")

    actual := readLines(std::argv(1))
    expected := readLines(std::argv(2))

    section := ""
    for i := 0; i < len(actual) || i < len(expected); i++ {
        a := i < len(actual) ? actual[i] : "<end of file>"
        e := i < len(expected) ? expected[i] : "<end of file>"

        if len(e) > 4 && slice(e, 0, 4) == ">>> " {
            section = e
        }

        if a != e {
            printf("Files differ at line %d%s\n", i + 1, section == "" ? "" : " in section " + section)
            printf("    actual:   %s\n", a)
            printf("    expected: %s\n", e)
            exit(1, "Files differ")
        }
    }

    printf("%d / %d lines\n", len(actual), len(expected))
    printf("OK\n")
}
