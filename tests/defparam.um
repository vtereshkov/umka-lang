type F = fn (s: str = "Hello"): str

const foo = fn (s: str = "Hello"): str {
   return "foo: " + s
}

type P = struct {
    x, y: int
}

type I = interface {
    bar(f: F, a: int, b: real = 3.14, c: ^int = null, d: P = P{5, 7}, e: []int = {7, 8}, g: any = null): P
}

type S = struct {
    state: int
}

fn (s: ^S) bar(f: F, a: int, b: real = 3.14, c: ^int = null, d: P = P{5, 7}, e: []int = {7, 8}, g: any = null): P {
    printf("%v %v %v %v %v %v %v\n", a, b, c == null, d, e, f(), g)
    return d
}

fn check(f: F, i: I) {
    printf(f() + '\n')
    printf(f("World") + '\n')

    v := 5

    i.bar(f, 2)
    i.bar(f, 2, 6.28)
    i.bar(f, 2, 6.28, &v)
    i.bar(f, 2, 6.28, &v, P{42, 43})
    i.bar(f, 2, 6.28, &v, P{42, 43}, {9, 10, 11})
    i.bar(f, 2, 6.28, &v, P{42, 43}, {9, 10, 11}, []str{"ah", "oh"})
}

// A default dynamic array is a constant shared by all calls, so modifying it in one call must not affect the next one
fn modify(items: []int = {1, 2, 3}) {
    printf("%v\n", items)
    items[0] = 99
    items = append(items, 4)
}

type Guest = struct {
    names: []str
}

// The dynamic arrays nested in a default value are shared by all calls, and anything stored in them stays alive
fn greet(guest: Guest = {names: {"nobody"}}, nobody: Guest = {}) {
    printf("%v %v\n", guest, nobody)
    guest.names[0] = sprintf("visitor #%d", len(guest.names[0]))
}

fn churn(): str {
    s := ""
    for i := 0; i < 1000; i++ {
        s = sprintf("garbage %d", i)
    }
    return s
}

fn test*() {
    s := S{}
    check(foo, s)

    for i := 0; i < 3; i++ {
        modify()
    }

    for i := 0; i < 3; i++ {
        greet()
        gc()
        churn()
    }
}

fn main() {
    test()
}