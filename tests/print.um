import "std.um"

fn test*() {
	printf("%d %v %f %v\n", 7, []int{42, 43}, 6.0, map[str]real{"Hello": 3.14, "World": 1 / 3.0})

	s := sprintf("%d %v %f %v\n", 7, []int{42, 43}, 6.0, map[str]real{"Hello": 3.14, "World": 1 / 3.0})
	printf("%s", s)

	{
		f, err := std::fopen("test.txt", "w")
		std::exitif(err)
		fprintf(f, "%d %v %f %v\n", 7, []int{42, 43}, 6.0, map[str]real{"Hello": 3.14, "World": 1 / 3.0})
		std::fclose(f)
	}

	{
		f, err := std::fopen("test.txt", "rb")
		std::exitif(err)
		chars, err := std::freadall(f)
		std::exitif(err)
		std::fclose(f)
		printf("%s", str(chars))
		std::remove("test.txt")
	}

	a, b := '\xD0', '\xBF'
    printf("%c%c\n", a, b)

	// Values of other sizes than the format specifiers give
	var i8: int8 = -5
	var i32: int32 = -1
	var u32: uint32 = 4000000000
	printf("%lld %5lld %llu %d %hhx\n", i8, i32, u32, 7, 255)
}

fn main() {
	test()
}