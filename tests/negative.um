// Negative tests: programs that must fail to compile, fail at run time, or compile with warnings
// Usage: umka negative.um <Umka executable>

import "std.um"

type Kind = enum {
    compileError
    runtimeError
    warning
    noWarning
}

type Case = struct {
    kind: Kind
    message: str        // Expected diagnostic message, which comes after the file name and the position
    source: str
}

const (
    sourceFile = "negative.tmp.um"
    outFile = "negative.tmp.out"
    errFile = "negative.tmp.err"
)

cases := []Case{
    // Compile errors

    {.compileError, "Unknown identifier thisFunctionIsNonsense", `
fn main() {
    thisFunctionIsNonsense()
}`},

    {.compileError, "Constant expected but variable x found", `
x := 5
const c = false && x > 2
fn main() {}`},

    {.compileError, "Nested functions should be declared as variables", `
fn main() {
    fn foo() {}
}`},

    {.compileError, "Function must return a value", `
fn f(): int {}
fn main() {}`},

    {.compileError, "Incompatible types int and str", `
fn main() {
    var x: int = "a"
}`},

    {.compileError, "Duplicate identifier a", `
fn main() {
    a := 1
    a := 2
}`},

    {.compileError, "Left side cannot be assigned to", `
fn main() {
    s := "abc"
    s[0] = 'x'
}`},

    {.compileError, "Constant must be ordinal, or real, or string, or closure", `
const c = []int{1}
fn main() {}`},

    {.compileError, "Structure type expected", `
type S = struct {int}
fn main() {}`},

    {.compileError, "Parameter must be of comparable or 'any' type to have default value", `
fn f(x: map[int]int = {}) {}
fn main() {}`},

    {.compileError, "No loop to break", `
fn main() {
    break
}`},

    {.compileError, "Cannot convert ^int to I: method f is not implemented", `
type I = interface {f()}
fn main() {
    var i: I = 5
}`},

    {.compileError, "Cannot open file", `
import "  path with spaces/b.um     "
fn main() {}`},

    {.compileError, "Cannot open file", `
import "        "
fn main() {}`},

    {.compileError, "Module name cannot contain spaces or tabs", `
import "path with spaces/module with spaces.um"
fn main() {}`},

    // Runtime errors

    {.runtimeError, "Division by zero", `
fn main() {
    a := 0
    printf("%v", 1 / a)
}`},

    {.runtimeError, "Index 2 is out of range 0...1", `
fn main() {
    a := []int{1, 2}
    i := 2
    printf("%v", a[i])
}`},

    {.runtimeError, "Pointer is null", `
fn main() {
    var p: ^int
    printf("%v", p^)
}`},

    {.runtimeError, "Map is null", `
fn main() {
    var m: map[int]int
    m = delete(m, 1)
}`},

    {.runtimeError, "Overflow of int8", `
fn main() {
    x := 300
    printf("%v", int8(x))
}`},

    {.runtimeError, "Pointer to a local variable escapes from the function", `
var g: ^int
fn f() {
    x := 1
    g = &x
}
fn main() {
    f()
}`},

    {.runtimeError, "Stack overflow", `
fn f(): int {
    return f() + 1
}
fn main() {
    f()
}`},

    {.runtimeError, "Assertion failed: Oops", `
import "std.um"
fn main() {
    std::assert(false, "Oops")
}`},

    {.runtimeError, "Bye", `
fn main() {
    exit(3, "Bye")
}`},

    // Warnings

    {.warning, "Identifier x is not used", `
fn main() {
    x := 1
}`},

    {.warning, "Module std is not used", `
import "std.um"
fn main() {}`},

    {.warning, "Shadowed identifier x", `
fn main() {
    x := 1
    {
        x := 2
        printf("%v", x)
    }
    printf("%v", x)
}`},

    {.warning, "Weak pointers are deprecated", `
type T = struct {p: weak ^T}
fn main() {
    var t: T
    printf("%v", t.p)
}`},

    {.noWarning, "", `
fn main() {
    _ := 5
}`}
}

fn readLines(name: str): []str {
    f, err := std::fopen(name, "rb")
    std::exitif(err)
    data, err := std::freadall(f)
    std::exitif(err)
    std::fclose(f)

    lines := []str{}
    start := 0
    for i := 0; i <= len(data); i++ {
        if i == len(data) || data[i] == '\n' {
            end := i
            for end > start && data[end - 1] == '\r' {
                end--
            }
            if end > start {
                lines = append(lines, str(slice(data, start, end)))
            }
            start = i + 1
        }
    }
    return lines
}

fn startsWith(s, prefix: str): bool {
    return len(s) >= len(prefix) && slice(s, 0, len(prefix)) == prefix
}

fn contains(s, sub: str): bool {
    for i := 0; i + len(sub) <= len(s); i++ {
        if slice(s, i, i + len(sub)) == sub {
            return true
        }
    }
    return false
}

fn run(umka: str, c: Case): bool {
    f, err := std::fopen(sourceFile, "wb")
    std::exitif(err)
    fprintf(f, "%s", c.source)
    std::fclose(f)

    options := ""
    switch c.kind {
        case .compileError:         options = "-check"
        case .runtimeError:         options = ""
        case .warning, .noWarning:  options = "-warn -check"
    }

    // Shell redirections that work both on Windows and on Linux
    code := std::system(sprintf("%s %s %s > %s 2> %s", umka, options, sourceFile, outFile, errFile))

    prefix := ""
    switch c.kind {
        case .compileError:         prefix = "Error "
        case .runtimeError:         prefix = "Runtime error "
        case .warning, .noWarning:  prefix = "Warning "
    }

    diagnostics := readLines(errFile)
    found := false
    for _, line in diagnostics {
        if startsWith(line, prefix) && (c.kind == .noWarning || contains(line, "): " + c.message)) {
            found = true
        }
    }

    ok := (c.kind == .noWarning ? !found : found) && ((code == 0) == (c.kind == .warning || c.kind == .noWarning))
    if !ok {
        kindNames := [4]str{"compile error", "runtime error", "warning", "no warning"}
        printf("FAILED: expected %s '%s', exit code %v, source:%s\n", kindNames[int(c.kind)], c.message, code, c.source)
        for _, line in diagnostics {
            printf("    %s\n", line)
        }
    }
    return ok
}

fn main() {
    std::assert(std::argc() == 2, "Need the Umka executable path")
    umka := std::argv(1)

    passed := 0
    for _, c in cases {
        if run(umka, c) {
            passed++
        }
    }

    std::remove(sourceFile)
    std::remove(outFile)
    std::remove(errFile)

    printf("%d / %d negative tests passed\n", passed, len(cases))
    if passed < len(cases) {
        exit(1, "Negative tests failed")
    }
}
