// Unreachable data is freed by garbage collection, including cycles

type List = struct {
    value: int
    next: ^List
}

// Memory in use after a full collection
fn liveBytes(): int {
    gc()
    return memusage()
}

fn report(name: str, before: int) {
    // Some growth is allowed, since a few objects may still be referenced from stale stack slots
    growth := liveBytes() - before
    if growth < 100000 {
        printf("%s: freed\n", name)
    } else {
        printf("%s: %v bytes not freed\n", name, growth)
    }
}

fn list(n: int): int {
    var p: ^List
    for i := 0; i < n; i++ {
        node := new(List)
        node.value = i
        node.next = p
        p = node
    }
    return p.value
}

fn cycle(n: int): int {
    var p, tail: ^List
    for i := 0; i < n; i++ {
        node := new(List)
        node.value = i
        node.next = p
        p = node
        if tail == null {
            tail = p
        }
    }
    tail.next = p
    return tail.next.value
}

fn contrived(arr: ^[]int, x: int): int {
    i := len(arr^)
    arr^ = append(arr^, 0)
    temp := make([]int, 100000)
    temp[0] = x
    if x != 0 {
        arr^[i] = contrived(arr, x - 1)
    }
    return temp[0] + 1
}

fn recursion(n: int): int {
    sum := 0
    for i := 0; i < n; i++ {
        arr := []int{}
        sum += contrived(&arr, 10)
    }
    return sum
}

fn test*() {
    before := liveBytes()
    printf("%v\n", list(1000000))
    report("List", before)

    before = liveBytes()
    printf("%v\n", cycle(100000))
    report("Cycle", before)

    before = liveBytes()
    printf("%v\n", recursion(1000))
    report("Recursion", before)
}

fn main() {
    test()
}
