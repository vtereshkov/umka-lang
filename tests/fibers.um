// Nested fibers exchanging data. Each line of the output is the trace of one parent iteration:
// P<parent iteration>:<b>, C<child iteration>:<a>,<d>, G<grandchild iteration>:<a>,<c>

fn test*() {
    a := new(int)
    b := new(int)
    trace := new(str)

    child := make(fiber, |a, b, trace| {
        c := new(int)
        d := new(int)

        grandchild := make(fiber, |a, c, d, trace| {
            for i := 0; i < 13; i++ {
                trace^ += sprintf(" G%d:%d,%d", i, a^, c^)
                d^ = i * 11
                resume()
            }
        })

        for i := 0; i < 5; i++ {
            for j := 0; j < 10; j++ {
                trace^ += sprintf(" C%d:%d,%d", i, a^, d^)
                c^ = j * 19
                resume(grandchild)
            }

            b^ = i * 3
            resume()
        }
    })

    for i := 0; i < 10; i++ {
        trace^ = sprintf("P%d:%d", i, b^)
        a^ = i * 7
        resume(child)
        printf("%s\n", trace^)
    }
}

fn main() {
    test()
}
